# Public Supabase project (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://bxvhabbuxwsdwpfeklfc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by Route Handlers and Server Actions. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared app password (Octavi-only MVP). Required in production.
# Login at /login. Session is an HMAC-signed httpOnly cookie.
APP_PASSWORD=

# Shared secret for Grok bots (Flow, Home, Mint, Dial).
# Authorization: Bearer <BOT_API_TOKEN>. Never expose to the client.
BOT_API_TOKEN=
